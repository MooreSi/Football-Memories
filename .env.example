# Copy to .env and edit. .env is gitignored; never commit it.

# Database password (required). Pick something long and random.
FM_DB_PASSWORD=change-me
FM_DB_USER=memories
FM_DB_NAME=memories

# Where the archive lives on this Mac (bind-mounted into the backend at /archive).
# Everything the app writes goes under <this folder>/FootballMemories/.
FM_HOST_ARCHIVE=./data/archive

# Folder you drop match videos (+ optional .tags.csv) into. Mounted read-only:
# the app copies from it and can never modify or delete your originals.
FM_HOST_INBOX=./data/inbox

# Browser port.
FM_PORT=8765

# 0.0.0.0 = phones and tablets on your Wi-Fi can open the app, with NO password:
# anyone on the same network can watch, download and use the Hudl connection.
# 127.0.0.1 = this computer only. (Owner decision D-028.)
FM_BIND=0.0.0.0

FM_LOG_LEVEL=INFO
